# Canonicalize: /index.html → / (301)
/index.html              /              301

# The universal AI index now lives inside the sponsor-supported homepage.
/local-ai-index.html     /#local-ai-index  301
/local-ai-index          /#local-ai-index  301

# Canonicalize blog root: /blog/index.html → /blog/ (301)
/blog/index.html         /blog/         301

# Invalid nested silo paths are intentionally not redirected. Cloudflare serves
# 404.html with a real 404 status, so crawlers can retire those obsolete URLs.

# Legacy typo redirect (old internal link referenced a non-existent file)
/blog/best-local-llms-2026.html   /blog/best-local-ai-models-2026   301

# Any stray attempt to reach root pages from /blog/ -> send to the real page
/blog/llm-list.html      /llm-list    301
/blog/llm-detail.html    /llm-list    301
