/blog/download.html      /download    301
/blog/new.html           /new         301
/blog/computers.html     /computers   301
/blog/tts-list.html      /tts-list    301

# Browser fallback favicon request — prevents noisy /favicon.ico 404s in console/crawlers
/favicon.ico             /images/favicon.png?v=20260211g   301

/changelog/localclaw-installer-v1.0.190  /download  302

/models                 /models/         301

