{
  "name": "localclaw-io",
  "version": "0.0.0",
  "private": true,
  "description": "Static LocalClaw website with Cloudflare Pages Functions.",
  "scripts": {
    "catalog:generate": "node scripts/generate-local-ai-catalog.js",
    "diy:generate": "node scripts/generate-diy-pages.js",
    "diy:check": "node scripts/check-diy-pages.js",
    "software:generate": "node scripts/generate-software-page.js",
    "software:check": "node scripts/generate-software-page.js --check",
    "nav:sync": "node scripts/sync-site-navigation.js",
    "nav:check": "node scripts/sync-site-navigation.js --check",
    "urls:normalize": "node scripts/normalize-public-urls.js",
    "urls:check": "node scripts/normalize-public-urls.js --check",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "seo:check": "node scripts/check-seo.js",
    "home-index:data": "node scripts/export-home-index-data.js",
    "home-index:check": "node scripts/check-home-index-logos.js && node scripts/check-home-index-analytics.js",
    "home-css:build": "tailwindcss -c scripts/tailwind.home.config.js -i scripts/home-tailwind.css -o css/home-tailwind-20260814a.css --minify",
    "site-css:build": "tailwindcss -c scripts/tailwind.site.config.js -i scripts/site-tailwind.css -o css/site-tailwind-20260823a.css --minify",
    "software-css:build": "tailwindcss -c scripts/tailwind.software.config.js -i scripts/site-tailwind.css -o css/software-tailwind-20260823a.css --minify",
    "charts:check": "node scripts/check-charts.js",
    "atlas:activity:generate": "node scripts/generate-admin1-activity.js",
    "atlas:admin1:generate": "node scripts/generate-global-admin1.js",
    "atlas:admin2:generate": "node scripts/generate-admin2-boundaries.js",
    "atlas:check": "node scripts/check-local-ai-activity-index.js && node scripts/check-atlas-periods.js",
    "tailwind-runtime:sync": "node scripts/sync-local-tailwind.js",
    "tailwind-runtime:check": "node scripts/sync-local-tailwind.js --check",
    "home-seo:generate": "node scripts/generate-home-seo.js",
    "home-seo:check": "node scripts/generate-home-seo.js --check",
    "public-surface:check": "npm run tailwind-runtime:check && node scripts/check-public-surface.js",
    "content-truth:check": "node scripts/check-content-truth.js",
    "computers:check": "node scripts/check-computers-model-fit.js",
    "recommendations:check": "node scripts/check-recommendations.js",
    "account-analytics:check": "node scripts/check-account-analytics.js",
    "conversion:check": "node scripts/check-conversion-improvements.js",
    "plans:check": "node scripts/check-local-ai-plans.js",
    "sponsor:check": "node scripts/check-sponsor-workspace.js && node scripts/check-sponsor-admin.js && node scripts/check-datafast-attribution.mjs",
    "sponsor-admin:check": "node scripts/check-sponsor-admin.js",
    "hf-repos:audit": "node scripts/audit-hf-repositories.js",
    "amazon:check": "node scripts/check-amazon-links.mjs",
    "pages:build": "npm run home-css:build && npm run site-css:build && npm run software-css:build && node scripts/build-pages-output.js",
    "pages:check": "npm run software:check && node scripts/check-pages-output.js"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.123.0"
  }
}
